# このファイルを .env という名前で写して、中身を書き換えて使う。
# .env は git に入らない（.gitignore を参照）。

# アクションをサーバーへ公開するための合言葉。
# 空か、未設定なら公開そのものができない（編集と手元への保存はできる）
ACTIONS_PUBLISH_PASSWORD=''

# LLM の設定。既定（local）のままなら書かなくてよい
#LLM_BACKEND=remote
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
#LLM_API_KEY=

# 同梱の llama-server が待ち受ける場所（LLM_BACKEND=local のとき）。
# 8080 が他のもので埋まっている環境では、ここを変える
#LLAMA_PORT=8080
#LLAMA_HOST=127.0.0.1

# キャラクタの性格（設定ウインドウからも変えられる）
#LLM_SYSTEM_PROMPT=''
